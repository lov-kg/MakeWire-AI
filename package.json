{
  "name": "makerwire-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run catalog:export && npm run theme:generate && vite",
    "build": "npm run catalog:export && npm run theme:generate && tsc --noEmit && vite build && npm run worker:build",
    "preview": "vite preview",
    "catalog:export": "node scripts/export-catalog.mjs",
    "theme:generate": "node scripts/generate-light-theme.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "worker:build": "wrangler pages functions build --outdir=.worker",
    "worker:dev": "npm run build && wrangler dev --port 8788",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir=.deploy-dry",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "wrangler": "^4.59.0"
  }
}
